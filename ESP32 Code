void updateSessions(String csv) {
    sessionCount = 0;
    int last = 0;
  
    while (true) {
      int idx = csv.indexOf(',', last);
      if (idx == -1) {
        sessions[sessionCount++] = csv.substring(last);
        break;
      }
      sessions[sessionCount++] = csv.substring(last, idx);
      last = idx + 1;
      if (sessionCount >= 10) break;
    }
  
    if (currentPage == PAGE_SESSIONS) {
      drawSessionsList();
    }
}

//-------------------  SEND SLACK MESSAGE FUNCTION  ---------------------

void sendSlackAlert(const String& name, const String& mobile, const String& status) {
    WiFiClientSecure ssl;
    ssl.setInsecure();
    
    HTTPClient http;
    Serial.println("Attempting to send Slack alert...");

    String maskedMobile;
    if (mobile.length() >= 10) {
        maskedMobile = "xxxxxx" + mobile.substring(mobile.length() - 4);
    } else {
        maskedMobile = "xxxxxx";
    }

    if (!http.begin(ssl, slackWebhookURL)) {
        Serial.println("Slack Connection Failed");
        return;
    }
    
    http.addHeader("Content-Type", "application/json");
  
    String text = "*Help-Desk Alert* :rotating_light:\n";
    text += "Attendee: *" + name + "*\n";
    text += "Mobile: " + maskedMobile + "\n";
    text += "Crew Help Requested: Yes";

    String body = "{\"text\":\"" + text + "\"}";
  
    int code = http.POST(body);
    
    if (code == 200 || code == 201) {
        Serial.println("✅ Slack Message Sent (Masked for Privacy)");
    } else {
        Serial.printf("❌ Slack Error: %d\n", code);
    }
  
    http.end();
}

// --------------------- Function to send SMS using SIM800L---------------------

void sendSMS(const String& number, const String& text) {

    Serial.println("--- SMS DEBUG START ---");


    // ============================================================
    // 0. CHECK WHETHER SIM800 IS ENABLED
    // ============================================================

    if (!SIM800_ENABLED) {

        Serial.println(
            "SIM800 is DISABLED."
        );

        Serial.println(
            "SMS sending skipped."
        );

        Serial.println(
            "Set SIM800_ENABLED = true when "
            "SIM800 is powered and connected."
        );

        Serial.println("--- SMS DEBUG END ---");

        return;
    }


    // ============================================================
    // 1. CHECK SIM800 COMMUNICATION
    // ============================================================

    while (sim800.available()) {
        sim800.read();
    }

    Serial.println("Checking SIM800...");

    sim800.println("AT");

    unsigned long start = millis();
    String atResponse = "";

    while (millis() - start < 2000) {

        while (sim800.available()) {
            char c = sim800.read();
            atResponse += c;
        }

        if (atResponse.indexOf("OK") != -1) {
            break;
        }

        delay(5);
    }

    if (atResponse.indexOf("OK") == -1) {

        Serial.println(
            "ERROR: SIM800 is not responding to AT."
        );

        Serial.println("--- SMS DEBUG END ---");
        return;
    }

    Serial.println("SIM800 AT communication OK.");


    // ============================================================
    // 2. CHECK NETWORK REGISTRATION
    //    Retry for a short period if registration is temporarily
    //    unavailable.
    // ============================================================

    bool registered = false;

    // Maximum registration wait:
    // 8 seconds
    unsigned long registrationStart = millis();

    while (millis() - registrationStart < 8000) {

        // Clear old response
        while (sim800.available()) {
            sim800.read();
        }

        Serial.println(
            "Checking network registration..."
        );

        sim800.println("AT+CREG?");

        unsigned long cregStart = millis();
        String cregResponse = "";

        // Wait up to 1500 ms for THIS response
        while (millis() - cregStart < 1500) {

            while (sim800.available()) {

                char c = sim800.read();

                cregResponse += c;
            }

            delay(5);
        }

        Serial.print("CREG Response: ");
        Serial.println(cregResponse);


        // --------------------------------------------------------
        // Registered on home network
        // +CREG: 0,1
        // --------------------------------------------------------

        if (cregResponse.indexOf("+CREG: 0,1") != -1 ||
            cregResponse.indexOf("+CREG: 1,1") != -1) {

            registered = true;

            Serial.println(
                "SIM800 network status: "
                "REGISTERED on home network."
            );

            break;
        }


        // --------------------------------------------------------
        // Registered while roaming
        // +CREG: 0,5
        // --------------------------------------------------------

        if (cregResponse.indexOf("+CREG: 0,5") != -1 ||
            cregResponse.indexOf("+CREG: 1,5") != -1) {

            registered = true;

            Serial.println(
                "SIM800 network status: "
                "REGISTERED while roaming."
            );

            break;
        }


        // --------------------------------------------------------
        // Not registered / still searching
        // +CREG: 0,0
        // +CREG: 0,2
        // --------------------------------------------------------

        Serial.println(
            "SIM800 not registered yet. "
            "Retrying..."
        );

        delay(300);
    }


    // ------------------------------------------------------------
    // Registration failed after retry period
    // ------------------------------------------------------------

    if (!registered) {

        Serial.println(
            "ERROR: SIM800 could not register "
            "on the cellular network within 8 seconds."
        );

        Serial.println(
            "SMS was NOT sent."
        );

        Serial.println("--- SMS DEBUG END ---");
        return;
    }


    // ============================================================
    // 3. SET SMS TEXT MODE
    // ============================================================

    while (sim800.available()) {
        sim800.read();
    }

    Serial.println(
        "Setting SMS text mode..."
    );

    sim800.println("AT+CMGF=1");

    start = millis();

    String cmgfResponse = "";
    bool textModeOK = false;

    while (millis() - start < 3000) {

        while (sim800.available()) {

            char c = sim800.read();

            cmgfResponse += c;
        }

        if (cmgfResponse.indexOf("OK") != -1) {

            textModeOK = true;
            break;
        }

        if (cmgfResponse.indexOf("ERROR") != -1) {
            break;
        }

        delay(5);
    }

    Serial.print(
        "CMGF Response: "
    );

    Serial.println(cmgfResponse);


    if (!textModeOK) {

        Serial.println(
            "ERROR: SIM800 could not enter "
            "SMS text mode."
        );

        Serial.println("--- SMS DEBUG END ---");
        return;
    }

    Serial.println(
        "SMS text mode: READY."
    );


    // ============================================================
    // 4. SEND AT+CMGS
    // ============================================================

    while (sim800.available()) {
        sim800.read();
    }

    Serial.println(
        "Sending SMS to: " + number
    );

    sim800.print("AT+CMGS=\"");
    sim800.print(number);
    sim800.println("\"");


    // ============================================================
    // 5. WAIT FOR '>' PROMPT
    // ============================================================

    start = millis();

    String cmgsResponse = "";
    bool ready = false;

    while (millis() - start < 5000) {

        while (sim800.available()) {

            char c = sim800.read();

            Serial.write(c);

            cmgsResponse += c;

            // SIM800 is ready for SMS body
            if (c == '>') {

                ready = true;
                break;
            }
        }

        if (ready) {
            break;
        }

        if (cmgsResponse.indexOf("ERROR") != -1) {
            break;
        }

        delay(5);
    }


    // ------------------------------------------------------------
    // No '>' prompt
    // ------------------------------------------------------------

    if (!ready) {

        Serial.println();

        Serial.println(
            "ERROR: SIM800 never gave '>' prompt."
        );

        Serial.println(
            "Complete CMGS response:"
        );

        Serial.println(cmgsResponse);

        Serial.println("--- SMS DEBUG END ---");
        return;
    }


    // ============================================================
    // 6. SEND SMS BODY
    // ============================================================

    Serial.println();
    Serial.println(
        "Prompt > received."
    );

    Serial.println(
        "Sending SMS text..."
    );

    sim800.print(text);

    delay(300);


    // ============================================================
    // 7. SEND CTRL+Z
    // ============================================================

    Serial.println(
        "Sending Ctrl+Z..."
    );

    sim800.write(26);


    // ============================================================
    // 8. WAIT FOR SMS RESULT
    // ============================================================

    Serial.println(
        "Waiting for SMS network response..."
    );

    start = millis();

    String smsResponse = "";

    while (millis() - start < 15000) {

        while (sim800.available()) {

            char c = sim800.read();

            Serial.write(c);

            smsResponse += c;
        }

        // SMS successfully submitted
        if (smsResponse.indexOf("+CMGS:") != -1) {

            Serial.println();
            Serial.println(
                "SMS SENT SUCCESSFULLY."
            );

            Serial.println(
                "--- SMS DEBUG END ---"
            );

            return;
        }

        // SMS failed
        if (smsResponse.indexOf("ERROR") != -1) {

            Serial.println();
            Serial.println(
                "SIM800 returned SMS ERROR."
            );

            Serial.println(
                "Complete SMS response:"
            );

            Serial.println(smsResponse);

            Serial.println(
                "--- SMS DEBUG END ---"
            );

            return;
        }

        delay(5);
    }


    // ------------------------------------------------------------
    // SMS response timeout
    // ------------------------------------------------------------

    Serial.println();

    Serial.println(
        "ERROR: Timed out waiting for SMS result."
    );

    Serial.println(
        "Complete SMS response:"
    );

    Serial.println(smsResponse);

    Serial.println(
        "--- SMS DEBUG END ---"
    );
}

// -------------------- MQTT callback: parse Slack message and send SMS----------------------

void callback(char* topic, byte* payload, unsigned int length) {
    Serial.print("DEBUG: New Message on Topic: "); Serial.println(topic);
    
    String msg = "";
    for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];
    Serial.println(msg);

    // --- Handle Slack ACK Response ---
    if (msg.startsWith("ACK:")) {
        String cleanMsg = msg.substring(4); 
        cleanMsg.replace("*", "");
        cleanMsg.replace("_", "");
        cleanMsg.trim();

        String crewPhone = "";
        int phoneSplitIndex = cleanMsg.lastIndexOf(":"); 
        if (phoneSplitIndex != -1) {
            crewPhone = cleanMsg.substring(phoneSplitIndex + 1);
            crewPhone.trim();
            cleanMsg = cleanMsg.substring(0, phoneSplitIndex);
            cleanMsg.trim();
        }

        String separator = " handled by ";
        int splitIndex = cleanMsg.indexOf(separator);

        String attendeeName = "";
        String crewName = "";

        if (splitIndex != -1) {
            attendeeName = cleanMsg.substring(0, splitIndex);
            crewName = cleanMsg.substring(splitIndex + separator.length());
        } else {
            attendeeName = uiName;
            crewName = cleanMsg;
        }

        uicrewHelp = false; 
        
        showCrewResponse(attendeeName, crewName); 
        
        Serial.println("--- SMS TRIGGER CHECK ---");
        
        if (lastScannedMobile.length() > 0) {
            Serial.print("Target Mobile Found: "); Serial.println(lastScannedMobile);
            String crewSms = buildCrewArrivalSMS(attendeeName, crewName, crewPhone);
            
            while(sim800.available()) sim800.read(); 
            sendSMS(lastScannedMobile, crewSms);
            delay(3500);
        } else {
            Serial.println("Memory empty, sending to TEST NUMBER instead...");
            String crewSms = buildCrewArrivalSMS(attendeeName, crewName, crewPhone);
            
            while(sim800.available()) sim800.read(); 
            sendSMS("9971505511", crewSms);
            delay(3500);
        }
        
        Serial.println("Slack Response Processed. Attendee: " + attendeeName + ", Crew: " + crewName + ", Phone: " + crewPhone);
        return;
    }

    // --- Handle Attendee Scan (JSON) ---
    StaticJsonDocument<512> doc; 
    DeserializationError error = deserializeJson(doc, msg);
    if (error) {
        Serial.println("JSON parse failed or message is not JSON");
        return;
    }

    String firstName = doc["firstName"] | "";
    String lastName = doc["lastName"] | "";
    String status = doc["status"] | "";
    String mobileNumber = doc["mobileNumber"] | "";
    String email = doc["email"] | "";
    String registrationNumber = doc["registrationNumber"] | "";
    String uniqueId = doc["uniqueId"] | "";
    bool crewHelp = doc["crewHelp"] | false;

    firstName.trim();
    status.trim();
    mobileNumber.trim();

    if (mobileNumber.length() == 0 || firstName.length() == 0) {
        Serial.println("Missing mobile number or first name in MQTT message.");
        return; 
    }

    lastScannedMobile = mobileNumber;
    client.publish("Jasakash/robot01/motion/control", "TALK_START");
    String maskedMobile = "xxxxxx" + (mobileNumber.length() >= 10 ? mobileNumber.substring(6) : "");

    Serial.println("--- SALESFORCE RECORD CREATION ---");
    QRFields fields;
    fields.firstName = firstName;
    fields.lastName = lastName;
    fields.mobileNumber = mobileNumber;
    fields.email = email;
    fields.registrationNumber = registrationNumber;
    fields.uniqueId = uniqueId;
    fields.status = status;
    fields.helpcrew = crewHelp ? "true" : "false";

    sendPlatformEvent(fields);

    Serial.println("--- UPDATING TFT SCREEN ---");
    uiName = firstName;
    uiStatus = status;
    uiMobile = maskedMobile;
    uicrewHelp = crewHelp;

    displayingData = true;
    resetScreenTimeout();
    
    updateTFT(firstName, status, maskedMobile, crewHelp);

    Serial.println("--- WELCOME SMS PROCESS ---");
    String welcomeMsg = buildPersonalizedSMS(firstName, status);

    while(sim800.available()) sim800.read(); 
