//-------------------------- Draw Sessions List------------------------------

void drawSessionsList() {
    if (tsSessions.indexOf("confirmed") != -1) {
        return; 
    }

    tft.fillRect(0, 45, 320, 140, BLACK); 
    
    if (tsSessions.indexOf("no requested sessions") != -1) {
        tft.setTextColor(WHITE);
        tft.setTextSize(2);
        tft.drawCentreString("No sessions found.", 160, 100, 1);
        tft.fillRect(0, 180, 320, 60, BLACK);
        
        drawOnlyBackButton(); 
        return; 
    }
    
    String sessionData = tsSessions;
    sessionData.replace("!", "");
    sessionData.trim();

    int y = 50;
    int paddingLeft = 15;
    int sessionNum = 1;
    int lastPos = 0;

    while (lastPos < sessionData.length()) {
        int semiPos = sessionData.indexOf(';', lastPos);
        String line = (semiPos != -1) ? sessionData.substring(lastPos, semiPos) : sessionData.substring(lastPos);
        line.trim();

        if (line.length() > 0) {
            if (!line.startsWith("Time") && !line.startsWith("Location")) {
                tft.setCursor(paddingLeft, y);
                tft.setTextColor(CYAN);
                tft.setTextSize(2);
                tft.print(sessionNum); tft.print(") ");
                tft.setTextColor(WHITE);
                tft.println(line);
                sessionNum++;
            } else {
                tft.setCursor(paddingLeft + 30, y);
                tft.setTextColor(WHITE);
                tft.setTextSize(1);
                tft.println(line);
                tft.setTextSize(2);
            }
            y = tft.getCursorY() + 4;
        }

        if (semiPos == -1) break;
        lastPos = semiPos + 1;
    }

    tft.setTextColor(YELLOW);
    tft.setTextSize(2); 
    tft.setCursor(paddingLeft, y + 5); 
    tft.println("Please Give Your Consent:");
}

