void handleTouch() {
    uint16_t x = 0, y = 0;
    if (tft.getTouch(&x, &y)) {

        lastInteractionTime = millis();

        // --- PAGE: MAIN (Home Screen) ---
        if (currentPage == PAGE_MAIN) {
            if (y > BTN_Y && y < 240) { 
                
                // 1. SESSIONS BUTTON
                if (x > BTN_LEFT_X && x < (BTN_LEFT_X + BTN_W)) {
                    Serial.println("SESSIONS CLICKED - Commanding Voice ESP");
                    client.publish("Jasakash/robot02/voice/control", "SESSION_VOICE");
                    
                    flashButton(BTN_LEFT_X, BTN_Y, BTN_W, BTN_H, CYAN, "Sessions", BLUE);
                    
                    currentPage = PAGE_SESSIONS;
                    
                    tft.fillScreen(BLACK);
                    tft.setTextColor(CYAN);
                    tft.drawCentreString("Fetching Sessions...", 160, 100, 1);
                    delay(100); 
                    
                    drawSessionsPage();
                    drawSessionsList();
                    resetScreenTimeout();
                }
                
                // 2. HELP YES BUTTON (Replaced Selfie Button Logic)
                else if (x > BTN_RIGHT_X && x < (BTN_RIGHT_X + BTN_W)) {
                    Serial.println("HELP YES CLICKED - Sending Slack Alert...");    
                    
                    uicrewHelp = true; // Update internal flag to help request active
                    
                    // Trigger Slack Notification on Demand
                    sendSlackAlert(uiName, uiMobile, uiStatus);
                    
                    flashButton(BTN_RIGHT_X, BTN_Y, BTN_W, BTN_H, CYAN, "Help YES", BLUE);
                    currentPage = PAGE_FEEDBACK; 
                    showFeedback("Crew Notified via Slack!", GREEN);
                    resetScreenTimeout();
                }
            }
        } 
        
        // --- PAGE: SESSIONS ---
        else if (currentPage == PAGE_SESSIONS) {
            if (tsSessions.indexOf("no requested sessions") != -1 || tsSessions.indexOf("confirmed") != -1) {
                if (x > 100 && x < 220 && y > 170) {
                    flashButton(100, 185, 120, 40, WHITE, "BACK", RED);
                    drawMainPage();
                    resetScreenTimeout();
                }
            } 
            else if (y > 170) {  
                if (x > 20 && x < 150) {
                    flashButton(20, 185, 130, 40, WHITE, "YES", GREEN);
                    sendConsentToSalesforce(true);
                    currentPage = PAGE_FEEDBACK; 
                    showFeedback("Response Sent To Salesforce", GREEN);
                    resetScreenTimeout();
                }
                else if (x > 170 && x < 300) { 
                    flashButton(170, 185, 130, 40, CYAN, "NO", RED);
                    drawMainPage();
                    resetScreenTimeout();
                }
            }
        }

        // --- PAGE: FEEDBACK ---
        else if (currentPage == PAGE_FEEDBACK) {
            if (x > 100 && x < 220 && y > 130 && y < 190) { 
                Serial.println("BACK/OK Clicked - Animating...");
                
                client.publish("Jasakash/robot01/motion/control", "MODE_DEFAULT");   
                                             
                flashButton(110, 145, 100, 35, WHITE, "BACK", BLUE);
                
                drawMainPage(); 
                resetScreenTimeout();
                delay(300);
            }
        }
    }
}

// -------------------------------fetch Sessions To Memory------------------------------------

void fetchSessionsToMemory() {
    HTTPClient http;
    String url = "https://api.thingspeak.com/channels/" + String(tsChannelId) + "/feeds/last.json?api_key=" + String(tsReadApiKey);
    
    Serial.println("--> [CACHE SYSTEM] Proactively fetching sessions from ThingSpeak...");
    if (http.begin(url)) {
        int code = http.GET();
        if (code == 200) {
            StaticJsonDocument<1024> doc; 
            deserializeJson(doc, http.getString());
            
            tsSessions = doc["field1"] | ""; 
            tsAttendeeId = doc["field2"] | "";
            
            Serial.println("--> [CACHE SYSTEM] Data successfully stored in background memory:");
            Serial.println(tsSessions);
            
            if (currentPage == PAGE_SESSIONS) {
                drawSessionsPage(); 
            }
        } else {
            Serial.printf("--> [CACHE SYSTEM] Fetch failed. HTTP Error: %d\n", code);
        }
        http.end();
    } else {
        Serial.println("--> [CACHE SYSTEM] Connection setup failed.");
    }
} 

