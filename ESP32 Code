 // ---------------- Salesforce Consent ----------------------

bool sendConsentToSalesforce(bool yes) {
    if (tsAttendeeId.length() == 0) {
      Serial.println("No tsAttendeeId set from ThingSpeak – cannot send consent.");
      return false;
    }
  
    if (sfAccessToken == "" || sfInstanceUrl == "") {
      if (!sfLogin()) {
        Serial.println("Salesforce login failed.");
        return false;
      }
    }
  
    WiFiClientSecure ssl;
    ssl.setInsecure();
    HTTPClient http;
  
    String url = sfInstanceUrl + "/services/apexrest/eventSessions";
  
    if (!http.begin(ssl, url)) {
      Serial.println("SF consent begin() failed");
      return false;
    }
  
    http.addHeader("Authorization", "Bearer " + sfAccessToken);
    http.addHeader("Content-Type", "application/json");
  
    String consent = yes ? "YES" : "NO";
  
    String body = "{";
    body += "\"attendeeId\":\"" + tsAttendeeId + "\",";
    body += "\"consent\":\""    + consent      + "\",";
    body += "\"robotId\":\"Robot01\"";
    body += "}";
  
    int code = http.POST(body);
    String resp = http.getString();
    http.end();
  
    Serial.printf("SF consent POST code: %d\n", code);
    return (code >= 200 && code < 300);
}

