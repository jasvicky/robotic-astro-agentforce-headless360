// ---------------- Salesforce OAuth ----------

bool sfLogin() {
    Serial.println("\n=============================================");
    Serial.println("--> [SF LOGIN] Starting Salesforce Login Process...");
    Serial.println("=============================================");

    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("--> [SF LOGIN] ERROR: WiFi is not connected! Cannot log in.");
        return false;
    }

    WiFiClientSecure ssl;
    ssl.setInsecure();
  
    HTTPClient http;
    String loginUrl = "https://login.salesforce.com/services/oauth2/token";
    
    if (!http.begin(ssl, loginUrl)) {
        Serial.println("--> [SF LOGIN] FATAL: http.begin() failed. Check URL or memory.");
        return false;
    }
  
    http.addHeader("Content-Type", "application/x-www-form-urlencoded");
  
    String body = "grant_type=password";     
    body += "&client_id="     + String(sfClientId);
    body += "&client_secret=" + String(sfClientSecret);
    body += "&username="      + String(sfUsername);
    body += "&password="      + String(sfPasswordTok);
  
    int httpCode = http.POST(body);
    String responsePayload = http.getString();
    http.end();
  
    Serial.printf("--> [SF LOGIN] HTTP Status Code Received: %d\n", httpCode);
  
    if (httpCode <= 0) {
        Serial.println("--> [SF LOGIN] Network Error: " + http.errorToString(httpCode));
        return false;
    }

    JsonDocument doc;
    DeserializationError err = deserializeJson(doc, responsePayload);
    if (err) {
        Serial.print("--> [SF LOGIN] JSON Parsing Failed: ");
        Serial.println(err.c_str());
        return false;
    }
  
    if (httpCode == 200 && doc.containsKey("access_token")) {
        sfAccessToken = doc["access_token"].as<String>();
        sfInstanceUrl = doc["instance_url"].as<String>();
        
        Serial.println("--> [SF LOGIN] SUCCESS! Connected Successfully.");
        return true;
    } 
    else {
        Serial.println("--> [SF LOGIN] FAILED: Credentials or Connected App configuration rejected.");
        return false;
    }
}

