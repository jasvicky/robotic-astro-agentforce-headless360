//----------------------- Dynamic Execution Flow --------------------------

void executeKioskFlow() {
    displayingData = true;
    resetScreenTimeout();
    Serial.println("\n--- PROCESSING KIOSK FLOW ---");

    uiName = uiFirstName + " " + uiLastName; 

    if (lastScannedMobile.length() >= 4) {
        uiMobile = "xxxxxx" + lastScannedMobile.substring(lastScannedMobile.length() - 4);
    } else {
        uiMobile = lastScannedMobile;
    }

    if (client.connected()) {
        String voicePayload = "{\"firstName\":\"" + uiFirstName + "\", \"status\":\"" + uiStatus + "\"}";
        client.publish("event/attendee", voicePayload.c_str());

        if (uiStatus == "Confirmed") {
            client.publish("Jasakash/robot01/motion/control", "TALK_START");
        }

        String pePayload = "{";
        pePayload += "\"FirstName\":\"" + uiFirstName + "\",";
        pePayload += "\"LastName\":\"" + uiLastName + "\",";
        pePayload += "\"MobileNumber\":\"" + lastScannedMobile + "\",";
        pePayload += "\"CrewHelp\":" + String(uicrewHelp ? "true" : "false") + ",";
        pePayload += "\"Email\":\"" + uiEmail + "\",";
        pePayload += "\"EventRegistrationNumber\":\"" + uiEventRegNum + "\",";
        pePayload += "\"Status\":\"" + uiStatus + "\",";
        pePayload += "\"HasAttended\":" + String(uiHasAttended ? "true" : "false") + ",";
        pePayload += "\"UIN\":\"" + uiUIN + "\"";
        pePayload += "}";

        client.publish("event/platform_event", pePayload.c_str());
    }
 
    delay(500); 
    client.loop(); 

    QRFields dataPacket;
    dataPacket.firstName          = uiFirstName;
    dataPacket.lastName           = uiLastName;
    dataPacket.mobileNumber       = lastScannedMobile; 
    dataPacket.email              = uiEmail;
    dataPacket.registrationNumber = uiEventRegNum;
    dataPacket.uniqueId           = uiUIN;
    dataPacket.status             = uiStatus;
    dataPacket.helpcrew           = uicrewHelp ? "true" : "false";
    dataPacket.hasAttended        = uiHasAttended;

    sendPlatformEvent(dataPacket);

    drawMainPage(); 

    fetchSessionsToMemory();
    lastTsCheck = millis(); 

    Serial.println("--- PROCESSING COMPLETE ---\n");
}

