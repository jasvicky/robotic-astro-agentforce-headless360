 // -------------------------- Send Platform Event -------------------
 
void sendPlatformEvent(const QRFields& fields) {
    Serial.println("--> [DEBUG] Inside sendPlatformEvent");

    if (sfAccessToken == "" || sfInstanceUrl == "") {
        if (!sfLogin()) {
            Serial.println("--> [DEBUG] SF Login failed! Aborting.");
            return;
        }
    }

    WiFiClientSecure sslClient;
    sslClient.setInsecure();
  
    HTTPClient http;
    String url = sfInstanceUrl + SF_EVENT_URL;

    if (http.begin(sslClient, url)) { 
        http.addHeader("Authorization", "Bearer " + sfAccessToken);
        http.addHeader("Content-Type", "application/json");

        StaticJsonDocument<512> doc;
        doc["First_Name__c"] = fields.firstName;
        doc["Last_Name__c"] = fields.lastName;
        doc["Email__c"] = fields.email;
        
        if (fields.mobileNumber.length() > 0) {
            doc["Mobile_Number__c"] = atoll(fields.mobileNumber.c_str());
        } else {
            doc["Mobile_Number__c"] = 0;
        }
        
        doc["Event_Registration_Number__c"] = fields.registrationNumber;
        doc["Unique_Identity_Number__c"] = fields.uniqueId;
        doc["Status__c"] = fields.status;
        doc["Ground_Help_Crew_Required__c"] = (fields.helpcrew == "true" || fields.helpcrew == "1");
        doc["Has_Attended__c"] = fields.hasAttended;  
         
        String body;
        serializeJson(doc, body);

        int httpCode = http.POST(body);
        String response = http.getString();

        if (httpCode == 201) {
            Serial.println("--> [DEBUG] Platform Event sent successfully!");
        } 
        else if (httpCode == 401) { 
            sfAccessToken = "";
            http.end();
            
            if (sfLogin()) {
                sendPlatformEvent(fields);
                return; 
            }
        } 
        else {
            Serial.println("--> [DEBUG] Failed to send platform event. Response: " + response);
        }

        http.end();
    } else {
        Serial.println("--> [DEBUG] FATAL: http.begin() failed!");
    }
}
