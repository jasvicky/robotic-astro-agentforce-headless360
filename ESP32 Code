// ---------------------------- LOOP ----------------------------------------

void loop() {
    handleTouch();    

    if (!client.connected()) {
        unsigned long now = millis();
        if (now - lastMqttRetry > 10000) {
            Serial.println("MQTT Connection Lost. Retrying...");
            lastMqttRetry = now;
            reconnectMQTT(); 
        }
    } else {
        client.loop();
    }

    static unsigned long lastHeartbeat = 0;
    if (millis() - lastHeartbeat > 30000) {
        Serial.println("...Loop Active (Waiting for Serial Scan/MQTT/Touch)...");
        lastHeartbeat = millis();
    }

    if (Serial.available() > 0) {
        String incomingString = Serial.readStringUntil('\n');
        incomingString.trim();

        if (incomingString.length() > 0) {
            if (incomingString == "s" || incomingString == "S") {
                simulateHelpRequest();
            } 
            else if (incomingString.startsWith("{")) {
                Serial.println("\n--- RECEIVED DYNAMIC JSON OVER SERIAL ---");
                
                JsonDocument doc; 
                DeserializationError error = deserializeJson(doc, incomingString);

                if (error) {
                    Serial.print("JSON Parsing Failed: ");
                    Serial.println(error.c_str());
                } else {
                    uiFirstName       = doc["firstName"] | "Unknown";
                    uiLastName        = doc["lastName"] | "User";
                    lastScannedMobile = doc["mobile"] | "0000000000";
                    uicrewHelp        = doc["crewHelp"] | false;
                    uiEmail           = doc["email"] | "no-email@example.com";
                    uiEventRegNum     = doc["regNum"] | "SF000000XX";
                    uiStatus          = doc["status"] | "Pending";
                    uiHasAttended     = doc["hasAttended"] | false;
                    uiUIN             = doc["uin"] | "SFUNKNOWN0000";

                    executeKioskFlow();
                }
            }
        }
    }

    if (currentPage == PAGE_MAIN && !displayingData) {
        if (millis() - lastBlinkTime > 500) {
            lastBlinkTime = millis();
            blinkState = !blinkState;
            drawIdleBlink();
        }
    }
    
    // -------------------- 45 SECOND INACTIVITY TIMEOUT --------------------
    // Every interactive screen gets its own 45-second inactivity window.
    // A valid touch resets lastInteractionTime (see handleTouch()).
    // The standby/Waiting-for-QR screen intentionally remains on-screen forever.
    if ((displayingData || currentPage != PAGE_MAIN) &&
        (millis() - lastInteractionTime >= dataDisplayDuration)) {

        Serial.println("45s Inactivity Timeout! Returning to Standby layout...");
        resetToStandby();
    }

    pollThingSpeak(); 
}

